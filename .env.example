# Supabase Public Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-anon-key

# Supabase Server-Only Secret (Never expose to client!)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Admin PIN SHA-256 Hash (Default PIN: 170402)
# Generated via: SHA-256("170402") = "f0a1dc78f56fa620e29b168e36e6a14777552b2f56ce23fb2f00a5dcfc18ce1c"
ADMIN_PIN_HASH=f0a1dc78f56fa620e29b168e36e6a14777552b2f56ce23fb2f00a5dcfc18ce1c

# JWT Session Secret
ADMIN_SESSION_SECRET=your-random-32-character-secret-key

# Site URL for SEO and Canonical Links
NEXT_PUBLIC_SITE_URL=http://localhost:3000
