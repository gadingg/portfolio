# Supabase public configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Server-only secret. Never expose this value to browser code.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# The single Supabase Auth email allowed to enter the CMS.
ADMIN_EMAIL=you@example.com
# Required in Vercel production for the daily 72-hour trash cleanup.
# Generate a random secret; Vercel sends it as the cron Authorization bearer.
CRON_SECRET=

# Optional stable server-only encryption secret for the Gemini key saved via admin.
# If omitted, the existing Supabase service-role secret is used for key derivation.
# Set before saving the Gemini key; rotating it requires re-entering the provider key.
# CMS_AI_ENCRYPTION_KEY=your-long-random-server-only-secret

# Site URL for metadata and same-origin links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
