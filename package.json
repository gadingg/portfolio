{
  "name": "gading-portfolio-cms",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build:icons": "node scripts/build-icons.cjs",
    "build:portfolio": "npm run build:icons && tailwindcss -i ./styles/portfolio.css -o ./public/assets/css/portfolio.css --minify",
    "dev": "npm run build:portfolio && next dev",
    "build": "npm run build:portfolio && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test:works": "node --test scripts/test-works.cjs",
    "test:visual": "node --test scripts/test-visual.cjs",
    "audit:supabase": "node scripts/audit-supabase-security.js"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.48.1",
    "cheerio": "^1.2.0",
    "clsx": "^2.1.1",
    "grapesjs": "^0.23.8",
    "lucide-react": "^0.475.0",
    "next": "^15.1.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sanitize-html": "^2.18.1",
    "tailwind-merge": "^3.0.1",
    "zod": "^3.24.2"
  },
  "overrides": {
    "postcss": "$postcss"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@types/sanitize-html": "^2.16.2",
    "autoprefixer": "^10.6.0",
    "eslint": "^9.20.1",
    "eslint-config-next": "^15.1.7",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3"
  }
}
