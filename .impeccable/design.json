  "narrative": {
    "dos": [
      "**Do** preserve separate structural and interactive border colors.",
      "**Do** keep actual artwork prominent, with captions outside its frame except for the video thumbnail's bottom title overlay.",
      "**Do** retain visible action labels, keyboard focus, and explicit loading or failure messages; carousel pause/resume controls use icons with state-specific accessible names and tooltips.",
      "**Do** respect reduced motion and let mobile action groups wrap."
    ],
    "rules": [
      {
        "name": "The Action and Emphasis Rule",
        "body": "Use orange for intentional emphasis and interaction, including the existing full-color contact surface; it is not a blanket restriction to small accents.",
        "section": "colors"
      },
      {
        "name": "The One Family Rule",
        "body": "Keep display, explanation, navigation, and controls in Manrope; hierarchy comes from scale, weight, spacing, and color.",
        "section": "typography"
      },
      {
        "name": "The Flat Interface Rule",
        "body": "Keep interface surfaces flat; preserve the soft screenshot shadow where it expresses the existing artwork treatment.",
        "section": "elevation"
      }
    ],
    "keyCharacteristics": [
      "Large artwork with captions outside its frame; video thumbnails use a bottom title overlay.",
      "Confident sans headings and quieter, readable explanations.",
      "Flat dark surfaces, thin dividers, and compact rectangular controls.",
      "Orange actions and emphasis, with an orange contact surface.",
      "Small interaction responses that respect reduced motion."
    ],
    "donts": [
      "**Don't** turn local artwork colors into new interface accents.",
      "**Don't** apply the screenshot shadow to ordinary buttons, navigation, or content rows.",
      "**Don't** import legacy admin or CV styling into the public showcase system.",
      "**Don't** promote small pre-heading context lines or artwork kickers into a reusable heading pattern; these existing exceptions are not canonized by this document."
    ],
    "overview": "A near-black canvas gives actual work the visual space to carry Gading's creative marketing and problem-solving identity. Warm white, broad Manrope lettering, and clear orange actions make the interface confident without competing with the artwork. English headings and action labels sit alongside natural Indonesian explanations.\n\nThis records the implemented public showcase, work collections, and case-study system, scoped by the showcase body class. It does not govern the admin or CV surfaces. The palette and component rules are extracted from `public/assets/css/showcase.css`, the public homepage, and the public collection and case-study components; page composition remains in the surface briefs.",
    "northStar": "The Work Leads"
  }
}
